{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "cacheMaxAge": "4w",
  "cacheMaxSize": "5GB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "outputLogs": "new-only"
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "outputLogs": "new-only"
    }
  }
}
